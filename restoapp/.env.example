# Base de données MariaDB
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/restoapp"

# Auth.js v5 — générer avec: openssl rand -base64 32
AUTH_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET"

# URL de l'application
NEXTAUTH_URL="http://localhost:5555"

# En production, mettre à true
NODE_ENV="development"
