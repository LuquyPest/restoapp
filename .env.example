# ─── Base de données ──────────────────────────────────────────────────────────
# Pour Docker Compose, laisser ces valeurs — DATABASE_URL est construit automatiquement
DB_ROOT_PASSWORD=rootpassword
DB_NAME=restoapp
DB_USER=restoapp
DB_PASSWORD=restopassword

# Pour une base externe (hors Docker), renseigner directement :
# DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET=changeme

NEXTAUTH_URL=https://compta2.daryu.xyz
AUTH_TRUST_HOST=true

# ─── Super Admin (créé au premier démarrage) ──────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ─── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=changeme
