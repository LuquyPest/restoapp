generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id             String   @id @default(cuid())
  name           String
  logo           String?
  currency       String   @default("$")
  taxRate        Float    @default(11.9)
  bonusRate      Float    @default(10)
  dividendRate   Float    @default(72.26)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employees      Employee[]
  grades         Grade[]
  menuItems      MenuItem[]
  suppliers      Supplier[]
  invoices       Invoice[]
  orders         Order[]
  payrolls       Payroll[]
  users          User[]
  charges        Charge[]
  partners       Partner[]
  loyaltyCards   LoyaltyCard[]
  weeklyReports  WeeklyReport[]

  @@map("restaurants")
}

model Grade {
  id            String     @id @default(cuid())
  name          String
  salaryPercent   Float
  dividendPercent Float      @default(0)
  restaurantId  String
  createdAt     DateTime   @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@map("grades")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         UserRole  @default(EMPLOYEE)
  restaurantId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  employee   Employee?
  sessions   Session[]
  accounts   Account[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Employee {
  id            String   @id @default(cuid())
  userId        String   @unique
  restaurantId  String
  gradeId       String
  firstName     String
  lastName      String
  phone         String?
  accountNumber String?
  hiredAt       DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  grade      Grade      @relation(fields: [gradeId], references: [id])
  orders     Order[]
  payrolls   Payroll[]

  @@map("employees")
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?  @db.Text
  price        Float
  costPrice    Float    @default(0)
  imageUrl     String?  @db.Text
  category     String
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderLines  OrderLine[]

  @@map("menu_items")
}

model Partner {
  id              String   @id @default(cuid())
  restaurantId    String
  name            String
  discountPercent Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@map("partners")
}

model Order {
  id             String      @id @default(cuid())
  restaurantId   String
  employeeId     String
  partnerId      String?
  loyaltyCardId  String?
  total          Float
  discountAmount Float       @default(0)
  status         OrderStatus @default(CONFIRMED)
  note           String?     @db.Text
  weekNumber     Int         @default(0)
  year           Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])
  partner    Partner?   @relation(fields: [partnerId], references: [id])
  loyaltyCard LoyaltyCard? @relation(fields: [loyaltyCardId], references: [id])
  lines      OrderLine[]

  @@map("orders")
}

model OrderLine {
  id         String @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Float
  costPrice  Float  @default(0)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_lines")
}

model Charge {
  id           String      @id @default(cuid())
  restaurantId String
  name         String
  amount       Float
  type         ChargeType  @default(DEDUCTIBLE)
  isActive     Boolean     @default(true)
  weekNumber   Int?
  year         Int?
  createdAt    DateTime    @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("charges")
}

model Supplier {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  contact      String?
  email        String?
  phone        String?
  address      String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invoices   Invoice[]

  @@map("suppliers")
}

model Invoice {
  id           String        @id @default(cuid())
  restaurantId String
  supplierId   String
  reference    String?
  amount       Float
  dueDate      DateTime
  paidAt       DateTime?
  status       InvoiceStatus @default(PENDING)
  note         String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier   Supplier   @relation(fields: [supplierId], references: [id])

  @@map("invoices")
}

model Payroll {
  id           String   @id @default(cuid())
  restaurantId String
  employeeId   String
  weekNumber   Int
  year         Int
  revenue      Float
  costRevenue  Float    @default(0)
  grossSalary  Float
  taxes        Float    @default(0)
  bonus        Float    @default(0)
  netSalary    Float
  dividends    Float    @default(0)
  totalToPay   Float    @default(0)
  isPaid       Boolean  @default(false)
  paidAt       DateTime?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@map("payrolls")
}

model WeeklyReport {
  id              String   @id @default(cuid())
  restaurantId    String
  weekNumber      Int
  year            Int
  revenue         Float    @default(0)
  costRevenue     Float    @default(0)
  salaries        Float    @default(0)
  chargesDeductible    Float @default(0)
  chargesNonDeductible Float @default(0)
  grossProfit     Float    @default(0)
  taxes           Float    @default(0)
  netProfit       Float    @default(0)
  bonusTotal      Float    @default(0)
  dividendTotal   Float    @default(0)
  treasury        Float    @default(0)
  partnerRevenue  Float    @default(0)
  clientRevenue   Float    @default(0)
  savedDividend   Float    @default(0)
  savedTreasury   Float    @default(0)
  taxDeclared     Boolean  @default(false)
  createdAt       DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, weekNumber, year])
  @@map("weekly_reports")
}

enum UserRole {
  SUPERADMIN
  OWNER
  MANAGER
  EMPLOYEE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

enum ChargeType {
  DEDUCTIBLE
  NON_DEDUCTIBLE
}

model LoyaltyCard {
  id              String   @id @default(cuid())
  restaurantId    String
  firstName       String
  lastName        String
  discountPercent Float
  expiresAt       DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@map("loyalty_cards")
}
