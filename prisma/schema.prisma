generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   String         @id @default(cuid())
  name                 String
  logo                 String?
  type                 CompanyType    @default(RESTO_BAR)
  currency             String         @default("$")
  taxRate              Float          @default(11.9)
  bonusRate            Float          @default(10)
  dividendRate         Float          @default(72.26)
  webhookUrl           String?        @db.Text
  webhookDay           Int            @default(1)
  webhookHour          Int            @default(1)
  stockAlertWebhookUrl String?        @db.Text
  taxType              TaxType        @default(TYPE3)
  taxBrackets          String?        @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  accessRoles          AccessRole[]
  charges              Charge[]
  employees            Employee[]
  grades               Grade[]
  ingredients          Ingredient[]
  invoices             Invoice[]
  loyaltyCards         LoyaltyCard[]
  menuItems            MenuItem[]
  notifications        Notification[]
  orders               Order[]
  partners             Partner[]
  payrolls             Payroll[]
  suppliers            Supplier[]
  users                User[]
  weeklyReports        WeeklyReport[]

  @@map("restaurants")
}

model Grade {
  id              String            @id @default(cuid())
  name            String
  salaryPercent   Float
  companyId       String            @map("restaurantId")
  createdAt       DateTime          @default(now())
  dividendPercent Float             @default(0)
  employees       Employee[]
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "grades_restaurantId_fkey")
  @@map("grades")
}

model AccessRole {
  id           String             @id @default(cuid())
  name         String
  companyId    String             @map("restaurantId")
  createdAt    DateTime           @default(now())
  permissions  AccessPermission[]
  users        User[]
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "access_roles_restaurantId_idx")
  @@map("access_roles")
}

model AccessPermission {
  id           String     @id @default(cuid())
  accessRoleId String
  page         String
  accessRole   AccessRole @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)

  @@unique([accessRoleId, page])
  @@map("access_permissions")
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  name                String?
  passwordHash        String
  role                UserRole    @default(EMPLOYEE)
  companyId           String?     @map("restaurantId")
  accessRoleId        String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  accounts            Account[]
  employee            Employee?
  sessions            Session[]
  accessRole          AccessRole? @relation(fields: [accessRoleId], references: [id])
  company             Company?    @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "users_restaurantId_fkey")
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_fkey")
  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_userId_fkey")
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Employee {
  id            String     @id @default(cuid())
  userId        String     @unique
  companyId     String     @map("restaurantId")
  gradeId       String
  firstName     String
  lastName      String
  phone         String?
  accountNumber String?
  hiredAt       DateTime   @default(now())
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  grade         Grade      @relation(fields: [gradeId], references: [id])
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  payrolls      Payroll[]

  @@index([gradeId], map: "employees_gradeId_fkey")
  @@index([companyId], map: "employees_restaurantId_fkey")
  @@map("employees")
}

model MenuItem {
  id           String       @id @default(cuid())
  companyId    String       @map("restaurantId")
  name         String
  description  String?      @db.Text
  price        Float
  costPrice    Float        @default(0)
  imageUrl     String?      @db.Text
  category     String
  isAvailable  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderLines   OrderLine[]
  recipeLines  RecipeLine[]

  @@index([companyId], map: "menu_items_restaurantId_fkey")
  @@map("menu_items")
}

model Partner {
  id              String     @id @default(cuid())
  companyId       String     @map("restaurantId")
  name            String
  discountPercent Float
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  orders          Order[]
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "partners_restaurantId_fkey")
  @@map("partners")
}

model Order {
  id             String       @id @default(cuid())
  companyId      String       @map("restaurantId")
  employeeId     String?
  partnerId      String?
  total                 Float
  discountAmount        Float           @default(0)
  customAdjustmentType  AdjustmentType?
  customAdjustmentValue Float?
  status                OrderStatus     @default(CONFIRMED)
  note           String?      @db.Text
  weekNumber     Int          @default(0)
  year           Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  loyaltyCardId  String?
  lines          OrderLine[]
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  loyaltyCard    LoyaltyCard? @relation(fields: [loyaltyCardId], references: [id])
  partner        Partner?     @relation(fields: [partnerId], references: [id])
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "orders_employeeId_fkey")
  @@index([loyaltyCardId], map: "orders_loyaltyCardId_fkey")
  @@index([partnerId], map: "orders_partnerId_fkey")
  @@index([companyId], map: "orders_restaurantId_fkey")
  @@map("orders")
}

model OrderLine {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Float
  costPrice  Float    @default(0)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([menuItemId], map: "order_lines_menuItemId_fkey")
  @@index([orderId], map: "order_lines_orderId_fkey")
  @@map("order_lines")
}

model Charge {
  id           String     @id @default(cuid())
  companyId    String     @map("restaurantId")
  name         String
  amount       Float
  type         ChargeType @default(DEDUCTIBLE)
  isActive     Boolean    @default(true)
  weekNumber   Int?
  year         Int?
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "charges_restaurantId_fkey")
  @@map("charges")
}

model Supplier {
  id           String     @id @default(cuid())
  companyId    String     @map("restaurantId")
  name         String
  contact      String?
  email        String?
  phone        String?
  address      String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  invoices     Invoice[]
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "suppliers_restaurantId_fkey")
  @@map("suppliers")
}

model Invoice {
  id           String        @id @default(cuid())
  companyId    String        @map("restaurantId")
  supplierId   String
  reference    String?
  amount       Float
  dueDate      DateTime
  paidAt       DateTime?
  status       InvoiceStatus @default(PENDING)
  note         String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier     Supplier      @relation(fields: [supplierId], references: [id])

  @@index([companyId], map: "invoices_restaurantId_fkey")
  @@index([supplierId], map: "invoices_supplierId_fkey")
  @@map("invoices")
}

model Payroll {
  id           String     @id @default(cuid())
  companyId    String     @map("restaurantId")
  employeeId   String?
  weekNumber   Int
  year         Int
  revenue      Float
  costRevenue  Float      @default(0)
  grossSalary  Float
  taxes        Float      @default(0)
  bonus        Float      @default(0)
  netSalary    Float
  dividends    Float      @default(0)
  totalToPay   Float      @default(0)
  isPaid       Boolean    @default(false)
  paidAt       DateTime?
  createdAt    DateTime   @default(now())
  employee     Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "payrolls_employeeId_fkey")
  @@index([companyId], map: "payrolls_restaurantId_fkey")
  @@map("payrolls")
}

model WeeklyReport {
  id                   String     @id @default(cuid())
  companyId            String     @map("restaurantId")
  weekNumber           Int
  year                 Int
  revenue              Float      @default(0)
  costRevenue          Float      @default(0)
  salaries             Float      @default(0)
  chargesDeductible    Float      @default(0)
  chargesNonDeductible Float      @default(0)
  grossProfit          Float      @default(0)
  taxes                Float      @default(0)
  netProfit            Float      @default(0)
  bonusTotal           Float      @default(0)
  dividendTotal        Float      @default(0)
  treasury             Float      @default(0)
  partnerRevenue       Float      @default(0)
  clientRevenue        Float      @default(0)
  savedDividend        Float      @default(0)
  savedTreasury        Float      @default(0)
  taxDeclared          Boolean    @default(false)
  createdAt            DateTime   @default(now())
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekNumber, year], map: "weekly_reports_restaurantId_weekNumber_year_key")
  @@map("weekly_reports")
}

model RateLimit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@map("rate_limits")
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  userId       String?
  userEmail    String?
  companyId    String?  @map("restaurantId")
  ip           String?
  metadata     String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([companyId], map: "audit_logs_restaurantId_idx")
  @@index([createdAt])
  @@map("audit_logs")
}

model LoyaltyCard {
  id              String     @id @default(cuid())
  companyId       String     @map("restaurantId")
  firstName       String
  lastName        String
  discountPercent Float
  expiresAt       DateTime
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@index([companyId], map: "loyalty_cards_restaurantId_fkey")
  @@map("loyalty_cards")
}

model Notification {
  id           String     @id @default(cuid())
  companyId    String     @map("restaurantId")
  type         String
  title        String
  body         String
  entityId     String?
  isRead       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, entityId], map: "notifications_restaurantId_type_entityId_key")
  @@index([companyId, isRead], map: "notifications_restaurantId_isRead_idx")
  @@map("notifications")
}

model Ingredient {
  id           String       @id @default(cuid())
  companyId    String       @map("restaurantId")
  name         String
  quantity     Float        @default(0)
  minQuantity  Float        @default(0)
  imageUrl     String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipeLines  RecipeLine[]

  @@index([companyId], map: "ingredients_restaurantId_idx")
  @@map("ingredients")
}

model RecipeLine {
  id           String     @id @default(cuid())
  menuItemId   String
  ingredientId String
  quantity     Float
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
  @@map("recipe_lines")
}

enum UserRole {
  SUPERADMIN
  OWNER
  MANAGER
  EMPLOYEE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

enum ChargeType {
  DEDUCTIBLE
  NON_DEDUCTIBLE
}

enum AdjustmentType {
  PERCENT
  FIXED
}

enum TaxType {
  TYPE1
  TYPE2
  TYPE3
  CUSTOM
}

enum CompanyType {
  RESTO_BAR
  GARAGE
  CONCESSION
}
